__all__ = ["isinstance", "subtype"]

import typing as tp

from typing_extensions import TypeForm

class subtype(type):
    __subtype_form__: tp.Any
    __subtype_instancecheck__: tp.Callable[[object], bool]
    __subtype_subclasscheck__: tp.Callable[[object], bool]

    def __new__[T](mcls: type[T], typx, /) -> T: ...
    def __instancecheck__(cls, obj, /) -> bool: ...
    def __subclasscheck__(cls, typx, /) -> bool: ...
    def __or__[T](cls: T, other, /) -> T: ...
    def __ror__[T](cls: T, other, /) -> T: ...

def isinstance[T](obj: object, typx: TypeForm[T], /) -> tp.TypeGuard[T]: ...
